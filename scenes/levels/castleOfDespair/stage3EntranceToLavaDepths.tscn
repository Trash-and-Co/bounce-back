[node name="Letter" type="Sprite2D" parent="." unique_id=454720088]
texture_filter = 1
position = Vector2(6327.0005, 2802)
scale = Vector2(3, 3)
texture = ExtResource("9_nt01p")
script = ExtResource("10_hyjvm")
letter_font = ExtResource("11_f6noa")
message = "Hey buddy!

You found the key in the Castle of Despair! I knew I could count on you.

Unfortunately, they've moved me down into the Magma Underworld. I'm still locked up, but that key can open my cage.

Follow the passage until the magma starts appearing. There's a big hole in the floor ahead. Drop in! That's the way down to me.

Bring the key and free me. Please hurry. It's getting a little too warm for a slime!

Your pal,
Bob"

